# VentureX environment variables
# Copy to .env.local and fill in. Do not commit .env.local.

# ────────────────────────────────────────────────────────────────────────
# InsForge
# ────────────────────────────────────────────────────────────────────────
# Get baseUrl from .insforge/project.json (the `oss_host` field) after
# `npx @insforge/cli link`. Get the anon key via:
#   npx @insforge/cli secrets get ANON_KEY
#
# NEXT_PUBLIC_INSFORGE_URL is also used server-side as INSFORGE_URL via the
# server-client factory (so we only paste the URL once).
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only copy of the same anon key. The InsForge SSR pattern reads this
# from process.env in server actions and route handlers (no public exposure).
INSFORGE_ANON_KEY=

# Admin/service key — full-access. Server-only. Use sparingly for backend
# tasks that legitimately need to bypass RLS (none in V1; reserved for ops).
INSFORGE_API_KEY=

# ────────────────────────────────────────────────────────────────────────
# OpenRouter — single API key, routes to multiple model families
# ────────────────────────────────────────────────────────────────────────
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Stage 1 extraction model (Claude Sonnet 5 default — Opus reserved for later stages)
STAGE_1_MODEL=anthropic/claude-sonnet-5

# Stage 1 critic model — MUST be a different family from STAGE_1_MODEL
STAGE_1_CRITIC_MODEL=openai/gpt-5.5

# Stage 2 weighting model (Claude Opus 4.7 default)
STAGE_2_MODEL=anthropic/claude-opus-4.7

# Stage 6 evidence-based candidate scoring model (Claude Opus 4.7 default).
# Scores researched candidates against the 7 weighted dimensions; the
# comparison table ranks its columns by the resulting aggregate.
STAGE_6_MODEL=anthropic/claude-opus-4.7

# ────────────────────────────────────────────────────────────────────────
# Cell research V2 — evidence acquisition providers
# ────────────────────────────────────────────────────────────────────────
# All variables below are server-only. V2 is opt-in and writes isolated
# research-run rows; it never overwrites canonical cells automatically.
EXA_API_KEY=
BRAVE_SEARCH_API_KEY=
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_ZONE=venturex_research

# SEC and GLEIF do not use API keys. SEC asks automated clients to identify
# themselves with an application name and contact address.
SEC_USER_AGENT=VentureX research <operations-email>

# Companies House requires a free developer API key.
COMPANIES_HOUSE_API_KEY=

# Big-gun fallback. Keep disabled until a later milestone explicitly enables
# it and authorizes the additional research spend.
PERPLEXITY_API_KEY=
CELL_RESEARCH_PERPLEXITY_ENABLED=false

# V2 run guardrails. The orchestrator also enforces per-policy limits.
CELL_RESEARCH_V2_SOFT_CAP_USD=5
CELL_RESEARCH_V2_HARD_CAP_USD=10

# Separate model families: the extractor proposes a value; the verifier judges
# whether the evidence supports it. Defaults are resolved in code if omitted.
CELL_RESEARCH_EXTRACT_MODEL=anthropic/claude-sonnet-4.6
CELL_RESEARCH_EXTRACT_FALLBACK_MODEL=openai/gpt-5.5
CELL_RESEARCH_VERIFY_MODEL=openai/gpt-5.5

# Optional: used by scripts/check-scoring.ts to sign in as a normal user so
# RLS applies during CLI dry-runs. Falls back to INSFORGE_API_KEY if unset.
VENTUREX_EMAIL=
VENTUREX_PASSWORD=

# ────────────────────────────────────────────────────────────────────────
# Pipeline limits (per eng review D4)
# ────────────────────────────────────────────────────────────────────────
# Hard cap on cost per run (Stage 1 + critic + Stage 2 cycle), in USD.
# Re-runs start fresh at $0. Default is conservative for the ABB-scale workload.
MAX_COST_USD_PER_RUN=5

# Maximum combined input tokens before Stage 1 will refuse to call.
# Above this, surface a clear error rather than truncating silently.
MAX_INPUT_TOKENS=200000

# ────────────────────────────────────────────────────────────────────────
# App
# ────────────────────────────────────────────────────────────────────────
# Used for OpenRouter HTTP-Referer header (good etiquette + analytics) and
# for OAuth redirect URLs (per InsForge SSR auth docs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
